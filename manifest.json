{
  "manifest_version": 3,
  "name": "UnicodeGuardian",
  "version": "1.0.0",
  "description": "Discover, inspect, and understand hidden Unicode characters and BiDi formatting in text and on webpages.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "UnicodeGuardian"
  },
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
